# 公开演示站环境变量覆盖项（模板，不含任何真实密钥）
#
# 用法：先 cp .env.example .env，再把本文件中「需要改」的项覆盖进根目录 .env。
# 不要直接拿本文件当 .env：基础编排里有 TENANT_*、MODEL_KEY_ENCRYPT_KEY 等
# 用 :? 强制要求的变量，缺少完整配置会在启动时直接报错。
# 根目录 .env 已被 .gitignore 排除，绝不提交。
#
# 生成随机值：openssl rand -hex 24（token）/ openssl rand -hex 32（AES 主密钥）

# ---- 必改：默认凭据与密钥（占位符一律替换）----
MYSQL_ROOT_PASSWORD=__CHANGE_ME_DB_PASSWORD__
POSTGRES_USER=__CHANGE_ME_PG_USER__
POSTGRES_PASSWORD=__CHANGE_ME_PG_PASSWORD__
POSTGRES_DSN=postgresql://__CHANGE_ME_PG_USER__:__CHANGE_ME_PG_PASSWORD__@127.0.0.1:5432/cs_agent_db
INTERNAL_API_TOKEN=__CHANGE_ME_INTERNAL_TOKEN__
TENANT_T_ADMIN_SECRET=__CHANGE_ME_ADMIN_SECRET__
TENANT_T_DEMO_SECRET=__CHANGE_ME_DEMO_SECRET__
MODEL_KEY_ENCRYPT_KEY=__CHANGE_ME_64_HEX_AES_KEY__
DEMO_CUSTOMER_DEMO_BUYER_KEY_SECRET=__CHANGE_ME_BUYER_PASSWORD__
GRAFANA_ADMIN_PASSWORD=__CHANGE_ME_GRAFANA_PASSWORD__

# ---- 演示入口：只开客户侧，关闭旧版商家预览链接 ----
CS_AUTH_DEMO_CUSTOMER_LOGIN=true
CS_AUTH_DEMO_GUEST_CHAT=true
CS_AUTH_DEMO_GUEST_TENANT_ID=t_demo
CS_AUTH_MERCHANT_PREVIEW_LOGIN=false

# ---- 对外端口与同源策略 ----
# 改了 HTTP_PORT，必须同步改 nginx-edge.conf.example 里所有 127.0.0.1:8080。
HTTP_PORT=8080
# 演示站是同源访问，CORS 保持空；填了反而会让第三方站点盗用演示 API。
# 注意：当前代码未读取 CORS_ALLOW_ORIGINS，不要把它当作安全护栏。
CORS_ALLOW_ORIGINS=

# ---- 成本 / 容量护栏（业务层 + 编排层）----
# 聊天 Worker 并发：真正卡吞吐的是模型配额，压低可控制同时烧 token 的轮次
CHAT_TURN_WORKERS=2
# 演示消息保留 7 天，定期归档，避免访客消息无限堆积
MSG_RETENTION_DAYS=7
# 租户级配额 daily_message_limit / max_concurrent_sessions 在 MySQL tenants 表，
# 不在 .env 里；启动后按 docs/公开演示部署指南.md 的 SQL 设置。
