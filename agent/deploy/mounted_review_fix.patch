+NEVER_EVIDENCABLE = {"退还", "打款", "支付", "扣款", "开通", "取消订单", "创建工单", "建工单",
+                     "转接人工", "转人工", "提交申请", "安排上门",
+                     "退款", "退款申请", "申请退款", "退了款", "退回款项", "款项打回", "付款",
